{
  "name": "nusuk-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "cd apps/api && npx prisma generate && npm run build && cd ../web && npm run build",
    "start": "bash start.sh",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
