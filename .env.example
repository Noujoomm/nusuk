# ─── Database ───
DATABASE_URL=postgresql://user:password@host:5432/nusuk_db

# ─── JWT ───
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── API Server ───
API_PORT=4000
NODE_ENV=production
CORS_ORIGINS=*

# ─── Frontend (leave empty for single-service deploy) ───
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_SOCKET_URL=

# ─── AI Agent (Roya Assistant — مساعد رؤية) ───
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-5
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5
ANTHROPIC_MODEL_COMPLEX=claude-opus-4-5

# Vision-based PDF parsing (attendance reports). أحدث Opus للدقة القصوى مع
# العربي. اختياري — لو غير معرّف يستخدم claude-opus-4-5 افتراضياً.
# CLAUDE_PDF_MODEL=claude-opus-4-5

# Guardrails
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_QUERY_LENGTH=2000
AI_MAX_TOKENS_PER_RESPONSE=4096

# Feature flags
AI_AGENT_ENABLED=true
AI_WRITE_OPERATIONS_ENABLED=false  # Phase 1 = read-only
