enum CustodyStatus {
  ACTIVE
  LOW_BALANCE
  SUSPENDED
  CLOSED
}

enum InvoiceStatus {
  UPLOADED
  APPROVED
  REJECTED
}

model Custody {
  id               String        @id @default(cuid())
  code             String?       @unique // nullable for existing rows, backfill then enforce
  name             String
  description      String?       @db.Text
  // Financial — nullable for safe migration, backfilled from totalAmount/remainingAmount
  initialBalance   Float?        @map("initial_balance")
  currentBalance   Float?        @map("current_balance")
  // Legacy fields kept for backward compat during migration
  totalAmount      Float         @default(0) @map("total_amount")
  remainingAmount  Float         @default(0) @map("remaining_amount")
  spentAmount      Float         @default(0) @map("spent_amount")
  balanceAddedAt   DateTime?     @map("balance_added_at")
  status           CustodyStatus @default(ACTIVE)
  notes            String?       @db.Text
  assignedToId     String?       @map("assigned_to_id")
  closedById       String?       @map("closed_by_id")
  closedAt         DateTime?     @map("closed_at")
  closingNotes     String?       @map("closing_notes") @db.Text
  closingBalance   Float?        @map("closing_balance")
  // Legacy fields
  category         String?
  subCategory      String?       @map("sub_category")
  trackId          String?       @map("track_id")
  createdById      String        @map("created_by_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  createdBy   User               @relation("CustodyCreator", fields: [createdById], references: [id])
  assignedTo  User?              @relation("CustodyOwner", fields: [assignedToId], references: [id])
  closedBy    User?              @relation("CustodyCloser", fields: [closedById], references: [id])
  members     CustodyMember[]
  invoices    CustodyInvoice[]
  balanceTxs  CustodyBalanceTransaction[]
  items       CustodyItem[]
  auditLogs   CustodyAuditLog[]

  @@index([status])
  @@index([assignedToId])
  @@map("custodies")
}

model CustodyMember {
  id         String   @id @default(cuid())
  custodyId  String   @map("custody_id")
  userId     String   @map("user_id")
  roleType   String   @default("viewer") @map("role_type") // manager | custodian | executor | viewer
  assignedById String? @map("assigned_by_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  custody    Custody @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  user       User    @relation("CustodyMemberUser", fields: [userId], references: [id])
  assignedBy User?   @relation("CustodyMemberAssigner", fields: [assignedById], references: [id])

  @@unique([custodyId, userId])
  @@index([custodyId])
  @@map("custody_members")
}

model CustodyInvoice {
  id            String        @id @default(cuid())
  custodyId     String        @map("custody_id")
  invoiceNumber String?       @map("invoice_number")
  name          String
  description   String?       @db.Text
  amount        Float
  invoiceDate   DateTime      @map("invoice_date")
  status        InvoiceStatus @default(UPLOADED)
  attachmentUrl String?       @map("attachment_url")
  attachmentName String?      @map("attachment_name")
  attachmentPath String?      @map("attachment_path")

  // AI Invoice Analyzer (Claude Vision) — populated when the invoice is
  // created through /ai-analyze + /ai-confirm. All fields are optional so
  // manually-created invoices are unaffected.
  aiExtracted     Boolean   @default(false) @map("ai_extracted")
  aiConfidence    Float?    @map("ai_confidence")
  aiCategory      String?   @map("ai_category")
  aiRiskLevel     String?   @map("ai_risk_level")     // low | medium | high
  aiRiskScore     Int?      @map("ai_risk_score")     // 0-100
  aiRiskFlags     String[]  @default([]) @map("ai_risk_flags")
  aiExtractionId  String?   @unique @map("ai_extraction_id")
  aiProcessedAt   DateTime? @map("ai_processed_at")
  vendorTaxNumber String?   @map("vendor_tax_number")
  vendorName      String?   @map("vendor_name")
  aiRawResponse   Json?     @map("ai_raw_response")

  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  custody     Custody              @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("InvoiceCreator", fields: [createdById], references: [id])
  attachments InvoiceAttachment[]

  @@index([custodyId])
  @@index([status])
  @@index([invoiceDate])
  @@index([vendorName])
  @@map("custody_invoices")
}

model AIExtractionLog {
  id             String   @id @default(cuid())
  custodyId      String   @map("custody_id")
  userId         String   @map("user_id")
  fileName       String   @map("file_name")
  fileSize       Int      @map("file_size")
  mimeType       String   @map("mime_type")
  status         String   // pending | completed | failed
  tokensUsed     Int?     @map("tokens_used")
  costInSar      Float?   @map("cost_in_sar")
  errorMessage   String?  @map("error_message") @db.Text
  processingTime Int?     @map("processing_time")  // milliseconds
  extractionId   String?  @unique @map("extraction_id") // links to CustodyInvoice.aiExtractionId
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([custodyId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_extraction_logs")
}

model InvoiceAttachment {
  id              String   @id @default(cuid())
  invoiceId       String   @map("invoice_id")
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  fileSize        Int      @map("file_size")
  mimeType        String   @map("mime_type")
  // Optional DB-backed storage so attachments survive Railway's ephemeral
  // filesystem. Existing rows (LOCAL) are unaffected.
  storageProvider String   @default("LOCAL") @map("storage_provider")
  fileData        Bytes?   @map("file_data")
  uploadedById    String   @map("uploaded_by_id")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  invoice    CustodyInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("InvoiceAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([invoiceId])
  @@map("invoice_attachments")
}

model CustodyBalanceTransaction {
  id              String   @id @default(cuid())
  custodyId       String   @map("custody_id")
  amount          Float
  transactionType String   @map("transaction_type") // add | deduct
  transactionDate DateTime @map("transaction_date")
  note            String?  @db.Text
  runningBalance  Float    @map("running_balance")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  custody   Custody @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BalanceTxCreator", fields: [createdById], references: [id])

  @@index([custodyId])
  @@map("custody_balance_transactions")
}

model CustodyAuditLog {
  id         String   @id @default(cuid())
  custodyId  String?  @map("custody_id")
  action     String   // CREATE, UPDATE, DELETE, CLOSE, ADD_MEMBER, REMOVE_MEMBER, ADD_INVOICE, APPROVE_INVOICE, REJECT_INVOICE, UPLOAD
  entityType String   @map("entity_type") // CUSTODY, INVOICE, MEMBER
  entityId   String   @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  custody Custody? @relation(fields: [custodyId], references: [id], onDelete: SetNull)
  user    User     @relation("CustodyAuditActor", fields: [userId], references: [id])

  @@index([custodyId])
  @@index([entityType])
  @@map("custody_audit_logs")
}

model CustodyItem {
  id                String   @id @default(cuid())
  custodyId         String   @map("custody_id")
  name              String
  responsibleUserId String?  @map("responsible_user_id")
  itemDate          DateTime @map("item_date")
  urgencyType       String   @default("non_urgent") @map("urgency_type") // urgent | non_urgent
